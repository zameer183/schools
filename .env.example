DATABASE_URL="postgresql://postgres:<DATABASE_PASSWORD>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=30&sslmode=require"
DIRECT_URL="postgresql://postgres:<DATABASE_PASSWORD>@db.<project-ref>.supabase.co:5432/postgres"

NEXT_PUBLIC_APP_NAME="Manarah Institute"
NEXT_PUBLIC_APP_URL="https://schools-plum.vercel.app"
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxx"

JWT_SECRET="replace-with-long-random-secret"
CRON_SECRET="replace-with-long-random-cron-secret"

# Optional fallback flags for database outage resilience
ALLOW_SUPABASE_REST_AUTH_FALLBACK="1"
ALLOW_SESSION_DB_FALLBACK="1"
FORCE_SUPABASE_REST_DATA_FALLBACK="0"

# SMTP Email (required for forgot-password emails)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Manarah Institute <your-email@gmail.com>"

# WhatsApp Cloud API (required for real sending worker)
WHATSAPP_CLOUD_PHONE_NUMBER_ID=""
WHATSAPP_CLOUD_ACCESS_TOKEN=""
WHATSAPP_CLOUD_API_VERSION="v20.0"

# Optional tuning
DISPATCH_MAX_PER_MINUTE="20"
LOG_SLOW_QUERIES="0"
SLOW_QUERY_MS="500"

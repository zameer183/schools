DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hms_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/hms_db?schema=public"

NEXT_PUBLIC_APP_NAME="Stitch HMS"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"

JWT_SECRET="replace-with-long-random-secret"
CRON_SECRET="replace-with-long-random-cron-secret"

# App URL (used for password reset links)
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# SMTP Email (required for forgot-password emails)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Manarah Institute <your-email@gmail.com>"

# WhatsApp Cloud API (required for real sending worker)
WHATSAPP_CLOUD_PHONE_NUMBER_ID=""
WHATSAPP_CLOUD_ACCESS_TOKEN=""
WHATSAPP_CLOUD_API_VERSION="v20.0"

# Optional tuning
DISPATCH_MAX_PER_MINUTE="20"
LOG_SLOW_QUERIES="0"
SLOW_QUERY_MS="500"
